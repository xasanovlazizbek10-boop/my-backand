# Anime Arena backend — environment
# Nusxa oling: Copy-Item .env.example .env  (Node env faylni o‘zi o‘qimaydi;
# qiymatlarni PowerShell’da $env:PORT=... ko‘rinishida bering yoki process manager ishlatilsin.)

NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Baza fayli (papka avtomatik yaratiladi)
DB_PATH=./data/anime-arena.db

# Sessiya umri (soatlarda)
SESSION_TTL_HOURS=720

# CORS: vergul bilan ajratilgan originlar. "null" — file:// sahifalar uchun.
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,null

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
RATE_LIMIT_AUTH_MAX=12

# Reverse proxy ortida bo‘lsa 1 qiling (X-Forwarded-For)
TRUST_PROXY=0

# HTTPS bo‘lsa cookie'larga Secure qo‘shiladi
SECURE_COOKIES=0

# So‘rov tanasi limiti (bayt)
BODY_LIMIT_BYTES=65536

# To‘liq o‘yin snapshoti uchun limit (bayt)
STATE_LIMIT_BYTES=524288

# Admin hisobi (Gmail band qilinadi; faqat shu parol bilan kirish mumkin)
ADMIN_EMAIL=xasanovlazizbek10@gmail.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Jonli (odamlar) turniri
LIVE_TOURNAMENT_SIZE=16
LIVE_PRIZE_COINS=30000
LIVE_PRIZE_DIAMONDS=10
LIVE_REST_MS=60000
LIVE_FIGHT_MIN_MS=18000
LIVE_FIGHT_MAX_MS=28000
LIVE_CYCLE_MS=3600000
LIVE_REGISTRATION_MS=3600000
LIVE_MIN_PARTICIPANTS=2
LIVE_TICKER_MS=1000
